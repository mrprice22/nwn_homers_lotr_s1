[Unit]
Description=NWN Homer's LotR dedicated server — season instance %i (podman, headless)
Documentation=file://%h/GIT/%i/bin/serve
# Instance name %i is the season repo's DIRECTORY NAME:
#   nwn-season-server@nwn_homers_lotr      -> the newest season (unnumbered repo)
#   nwn-season-server@nwn_homers_lotr_s1   -> archived season 1
# Every season repo lives at %h/GIT/<dir> (season-cutover-guide.md, "REPOS"),
# so WorkingDirectory/ExecStart need no env indirection. The container name does
# — it differs per season — and comes from the instance env file written by
# bin/season-units.sh --install.
#
# Replaces the old XDG-autostart launch, which only fired on a *graphical*
# login -- so any desktop-login failure left the server down. The lingering
# user manager + this unit start it headlessly on every boot, GUI or not.
#
# NOTE: do NOT add `After=nwn-season-backup@%i.service` -- that backup unit is
# itself `After=default.target`, and this unit is `WantedBy=default.target`,
# so ordering after it creates a dependency cycle and systemd drops this
# unit's start job. The boot backup snapshots in ~3s while the server is still
# loading its module (well before any player writes), so concurrent start is
# safe in practice.

[Service]
Type=simple
WorkingDirectory=%h/GIT/%i
# Required, not optional (no leading '-'): without NWN_CONTAINER_NAME the
# ExecStop below would try to stop a container with no name, and a season would
# be left running after a "stop". Fail loudly at start instead.
EnvironmentFile=%h/.config/nwn-season/%i.env
ExecStart=%h/GIT/%i/bin/serve
# serve runs `podman run` in the foreground; a clean stop tears down the
# container (--rm) and the activity monitor via serve's own EXIT/TERM trap.
ExecStop=/usr/bin/podman stop -t 20 ${NWN_CONTAINER_NAME}
TimeoutStopSec=45
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
