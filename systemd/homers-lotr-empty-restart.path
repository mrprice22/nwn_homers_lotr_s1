[Unit]
Description=Watch for the Anvil reboot-on-empty restart request flag
Documentation=file:///var/home/james/GIT/nwn_homers_lotr/bin/empty-restart-handler

[Path]
# The ServerRestartManager plugin drops this file after it exports characters and
# shuts the server down for an adhoc reboot-on-empty. Path is the server's Anvil
# PluginData dir, which lives under the userdirectory (NWN_RUN_DIR, bind-mounted to
# /nwn/run) — NOT NWN_HOME_DIR. Keep in sync with NWN_RUN_DIR in server.env.
PathExists=%h/.local/state/nwnxee-homer/anvil/PluginData/restart-server
Unit=homers-lotr-empty-restart.service

[Install]
WantedBy=default.target
