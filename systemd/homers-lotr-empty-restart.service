[Unit]
Description=Restart Homer's LotR server after an adhoc reboot-on-empty
Documentation=file:///var/home/james/GIT/nwn_homers_lotr/bin/empty-restart-handler
# Triggered by homers-lotr-empty-restart.path when the plugin drops the
# restart-server flag. The handler consumes the flag, optionally rebuilds NWSync,
# then restarts homers-lotr-server.service onto the freshly deployed module.

[Service]
Type=oneshot
ExecStart=/var/home/james/GIT/nwn_homers_lotr/bin/empty-restart-handler
