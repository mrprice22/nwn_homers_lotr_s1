        },
        "Script": {
          "type": "resref",
          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*She closes your fingers round the glass and does not let go for a second longer than is comfortable.* Do not lose it, and do not stare at it either. It is not going to glow.\n\nWhen the bill comes, bring it back."
          }
        }
      },
      {
