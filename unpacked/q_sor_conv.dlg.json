          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*She glances at the pocket where you are keeping the glass and goes back to feeding the fire.* Still cheap, then. Good. Nobody sensible hurries that part.\n\nGo on. It will find you."
          }
        }
      },
      {
        "__struct_id": 4,
        "Animation": {
          "type": "dword",
          "value": 0
        },
