              }
            }
          ]
        },
        "Script": {
          "type": "resref",
          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Halbarad inclines his head.* Into the vigil, and road enough behind you to keep it true -- you have walked the first of the uncrowned path, and walked it well. There are greater things down that road, when the hour comes: the Elendilmir, the Grey Company mustered and riding, and a crown at the end of it. But that is for a far greater day. Keep the watch, friend."
          }
        }
      },
      {
        "__struct_id": 6,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
