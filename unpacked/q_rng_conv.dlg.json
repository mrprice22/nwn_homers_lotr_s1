          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Halbarad presses a plain silver cloak-brooch into your hand, a small star worked at its centre.* Taken up, then. The Brooch of the Grey Watch -- wear it, and let it steady you to the road. Go and walk it hard; come back at your eighth level and I will trust you with the real work."
          }
        }
      },
      {
        "__struct_id": 8,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
