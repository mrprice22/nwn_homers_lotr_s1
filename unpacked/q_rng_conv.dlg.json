        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*He pins the star inside your cloak himself, where no one will see it.* Carry it well, and carry it hidden. The Company keeps faith with the man who keeps the road -- come back at fifteen and we shall see it made into something that answers."
          }
        }
      },
      {
        "__struct_id": 9,
        "Animation": {
          "type": "dword",
