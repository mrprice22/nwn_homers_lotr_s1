        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The warden gives you a civil nod and returns to watching the road.* Good day to you. I keep the watch here and my own counsel -- the grey road is a poor bargain, and no burden for folk who have not the wandering in them. Go safely, and keep to the daylight."
          }
        }
      },
      {
        "__struct_id": 7,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
