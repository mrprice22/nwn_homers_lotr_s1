        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "Ned Puddifoot, of the Frogmorton Puddifoots. That cask came here in MY barrow, the whole nine miles from the Floating Log, and not a drop spilled. Mind the floor -- it's just been mopped."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
