        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The shade stands straighter than any living dwarf* The fires burn. The wraith is unmade. The twentieth plot of Mazarbul is sealed, and my watch — our watch — is ended at last."
          }
        }
      },
      {
        "__struct_id": 2,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
