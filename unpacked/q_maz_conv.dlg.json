          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "The third fire burns — and it has come, as it came for us! Destroy the wraith! If it slips from your sight, stir any seal-brazier's flame and it will return to smother it."
          }
        }
      },
      {
        "__struct_id": 4,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
