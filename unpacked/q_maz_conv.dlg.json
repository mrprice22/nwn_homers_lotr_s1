        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*He presses a heavy signet into your palm; it is grave-cold, and then it is not* The warden's seal, and what gold the colony still owes its friends. Baruk Khazâd! Go in honor, friend of Durin's folk."
          }
        }
      },
      {
        "__struct_id": 3,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
