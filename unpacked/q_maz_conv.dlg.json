        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The shade is faint now, and quiet* The twentieth plot lies sealed, friend of Durin's folk. Frár remembers."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
