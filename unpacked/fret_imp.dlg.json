        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "Oi! Who let you into Bill Ferny's house? That's me -- Bill Ferny -- and this is my house, so take your muddy boots back out the way they came."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
