          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "Heh. Sensible sort, ye are. There's yer coin -- now off ye go. And mind: ye never saw me. I'll be gone from Bree by week's end anyhow."
          }
        }
      },
      {
        "__struct_id": 3,
        "Animation": {
          "type": "dword",
