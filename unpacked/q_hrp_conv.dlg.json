          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*She does not look up* You still carry the keeper's word, cousin. Words are for delivering — the Well is not so far."
          }
        }
      },
      {
        "__struct_id": 2,
        "Animation": {
          "type": "dword",
