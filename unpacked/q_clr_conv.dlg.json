          "type": "resref",
          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Aldamir inclines his head.* Into the tending, and faith enough to carry the Flame -- you have walked the first of the priest's road, and walked it true. There are greater consecrations yet to come, when your calling comes into its full: the aura of Narya, and gifts beyond it. But that is for a far greater day. Keep to the Fire, my friend."
          }
        }
      },
      {
        "__struct_id": 6,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
