        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The keeper gives you a courteous blessing over the flame.* Peace be on you. I tend the Secret Fire and keep my own counsel -- the deep calling is no light thing, and no burden for folk who do not carry it. Go safely."
          }
        }
      },
      {
        "__struct_id": 7,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
