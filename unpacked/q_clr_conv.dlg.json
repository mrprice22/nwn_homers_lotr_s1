          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Aldamir tends the coals a moment.* Tending the Fire, are you -- good; but faith is proved on the long road, not in a warm shrine. Go and keep the calling; grow deep in it. Come back to me when you have eight levels of the priest's craft behind you, and I will trust you with something that matters."
          }
        }
      },
      {
        "__struct_id": 2,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
