        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Findegil presses a plain grey amulet into your hand.* Taken up, then. The Apprentice's Amulet -- wear it, and let it steady your young mind to the Art. Go and grow deep; come back at your eighth level and I will trust you with the real work."
          }
        }
      },
      {
        "__struct_id": 8,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
