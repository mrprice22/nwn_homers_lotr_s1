        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The old man gives you a courteous nod over his books.* Well met. I keep to my study and my own counsel -- the deep lore is no light thing, and no business of folk who do not carry the spark. Go safely."
          }
        }
      },
      {
        "__struct_id": 7,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
