          "type": "resref",
          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Findegil inclines his head.* Into the study, and lore enough to carry -- you have walked the first of the wizard's road, and walked it true. There are colours yet to choose, when your power comes into its full: White, or Brown, or the Many Colours. But that is a choice for a far greater day. Keep to the Art, my friend."
          }
        }
      },
      {
        "__struct_id": 6,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
