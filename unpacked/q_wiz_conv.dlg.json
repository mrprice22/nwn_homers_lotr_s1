        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*He takes the grey book back and turns its pages with quiet satisfaction.* Fifteen levels, and the lore is set deep in you now -- I knew the spark. A tome is a beginning; a wizard should carry his study in his hand. Let me bind what you have learned into a staff for you. Shall it be done?"
          }
        }
      },
      {
        "__struct_id": 5,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
        },
        "Comment": {
          "type": "cexostring",
