                "value": 0
              }
            }
          ]
        },
        "Script": {
          "type": "resref",
          "value": ""
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*He draws a slim grey book from the shelf and weighs it in both hands.* This is the Loremaster's Tome -- my own study of the Colour of Power, close-written over long years. Much of it you cannot yet read. *He sets it before you.* Carry it into the wide world; study as you walk, let the Art deepen in you, and bring it back to me when you have grown, at the fifteenth level. Will you bear it?"
          }
        }
      },
      {
        "__struct_id": 3,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
        },
        "Comment": {
          "type": "cexostring",
          "value": ""
        },
        "Delay": {
          "type": "dword",
          "value": 4294967295
        },
