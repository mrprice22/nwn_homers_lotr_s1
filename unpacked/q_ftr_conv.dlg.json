        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Hallas nods.* You have taken the oath -- good. But an oath is proven in years, not words. Go and soldier; grow into your strength. Come back to me when you have eight levels of the fighter's trade behind you, and I will have a harder charge for you."
          }
        }
      },
      {
        "__struct_id": 2,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
