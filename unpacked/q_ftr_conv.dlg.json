          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Hallas grips your forearm in the old soldier's clasp.* Sworn, then. *He presses a plain white buckler into your hands.* The Unbroken Shield -- bear it, and remember what it stands for. Go and grow into your oath; come back at your eighth level and I'll have a harder charge for you."
          }
        }
      },
      {
        "__struct_id": 8,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
