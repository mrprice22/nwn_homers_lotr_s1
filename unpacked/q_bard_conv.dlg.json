        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "Then teach me the phrase, and I will hand it on."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
