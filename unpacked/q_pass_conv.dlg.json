          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Baldor waves you up the road.* You've taken my coin already -- the wagons are rolling! Get up the pass and see them down safe to Wilrun at the eastern waystation. I'll not pay twice for the one run."
          }
        }
      },
      {
        "__struct_id": 3,
        "Animation": {
          "type": "dword",
