          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Baldor tips his hat.* You've already earned your pay off me today, friend, and my next train's not loaded yet. Come back tomorrow -- about <CUSTOM6395> from now -- and I'll have another run over the pass for you."
          }
        }
      },
      {
        "__struct_id": 2,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
