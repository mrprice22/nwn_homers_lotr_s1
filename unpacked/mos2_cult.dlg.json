        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "[Persuade] The Eye keeps nothing here but ash and bones. Bree remembers its sons -- give me the boy and you keep yours. Refuse, and every blade between here and the Prancing Pony learns the road to this camp."
          }
        }
      },
