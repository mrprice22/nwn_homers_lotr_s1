        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*A gaunt man turns from the fire, and when he speaks the whole camp goes still.* Another stray on the Greenway. This ground belongs to the Red Eye now, little wanderer. The miller's whelp? *He smiles.* The boy gave himself to the Eye of his own will -- he's trussed in the tent behind me until his faith firms up. The Eye keeps what it is given."
          }
        }
      },
      {
        "__struct_id": 1,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
          "value": 1
