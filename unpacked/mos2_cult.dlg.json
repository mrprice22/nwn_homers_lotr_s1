        },
        "Script": {
          "type": "resref",
          "value": "q_mos2_fight"
        },
        "Sound": {
          "type": "resref",
          "value": ""
        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*The Voice laughs -- a dry, papery sound, and the camp laughs with him.* The Eye does not bargain with carrion. Kill this one slowly."
          }
        }
      },
      {
        "__struct_id": 3,
        "Animation": {
