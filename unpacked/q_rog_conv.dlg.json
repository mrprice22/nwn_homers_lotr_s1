        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*Fenn presses a folded ash-grey cloak into your hands, quick and unshowy.* Sworn, then. The Shadowmantle -- wear it, and learn to be where no one's looking. Go and grow sharp; come back at your eighth level and I'll trust you with the real work."
          }
        }
      },
      {
        "__struct_id": 8,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
