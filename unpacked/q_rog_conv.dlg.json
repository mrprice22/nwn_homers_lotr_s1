        },
        "Speaker": {
          "type": "cexostring",
          "value": ""
        },
        "Text": {
          "type": "cexolocstring",
          "value": {
            "0": "*He palms the token into your pack himself, so smooth you barely feel it.* Carry it well, and carry it quiet. Steel keeps faith with the hand that never dropped it -- come back at fifteen and we'll see it made into something with an edge."
          }
        }
      },
      {
        "__struct_id": 9,
        "Animation": {
          "type": "dword",
          "value": 0
        },
        "AnimLoop": {
          "type": "byte",
